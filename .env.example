# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Server-side Firebase Admin SDK Service Account JSON (for Vercel / backend Auth sync & cascade deletes)
FIREBASE_SERVICE_ACCOUNT=

# Brevo (formerly Sendinblue) Transactional Email Service
BREVO_API_KEY=
BREVO_SMTP_USER=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Email Service (Resend Fallback)
RESEND_API_KEY=

# Payment (Paystack)
# Frontend / Vite Client Key:
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
# Alternative Vercel frontend / server key names also supported:
live_public_key=pk_live_...
VITE_LIVE_PUBLIC_KEY=pk_live_...

# Backend Server Secret Key (Never exposed to client):
PAYSTACK_SECRET_KEY=sk_live_...
# Alternative Vercel server secret key names also supported:
live_paystack_key=sk_live_...

# CheapDataHub VTU Data Subscriptions
CHEAPDATAHUB_API_KEY=

# Shipbubble Logistics Courier Delivery
SHIPBUBBLE_API_KEY=

# Payment (EscrowPay - Server-Side Only, never expose secret keys to client)
# Official Merchant API host for both Sandbox (ep_test_sk_...) and Live (ep_live_sk_...):
ESCROWPAY_MODE=test
ESCROWPAY_API_BASE_URL=https://production-business-api.escrowpay.app
ESCROWPAY_TEST_SECRET_KEY=ep_test_sk_...
ESCROWPAY_TEST_PUBLIC_KEY=ep_test_pk_...
# Optional Live Secret Key (only set when business verification is complete and ready for live mode)
ESCROWPAY_LIVE_SECRET_KEY=
# Webhook signing secret from EscrowPay Developer Settings (whsec_...)
ESCROWPAY_WEBHOOK_SECRET=whsec_...
ESCROWPAY_WEBHOOK_SECRET_PREVIOUS=

